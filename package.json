{
  "name": "immich-frame-album",
  "private": true,
  "version": "1.0",
  "scripts": {
    "dev": "concurrently \"vite\" \"pocketbase serve --dir=pb_data --dev --hooksPool=2\"",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "pocketbase serve --dir=pb_data --dev --hooksPool=2",
    "wsl": "wsl bash -c \"set -a && source .env && set +a && npm run dev\"",
    "push": "node scripts/push.mjs",
    "login": "phio login",
    "update": "pocketbase update",
    "typegen": "node scripts/typegen.mjs",
    "postinstall": "patch-package",
    "start": "phio dev blinks"
  },
  "description": "Immich Frame Site Using Vue.js & PocketBase.",
  "author": {
    "name": "Justin Kim",
    "github": "kimjust6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kimjust6/pocket-frame.git"
  },
  "keywords": [
    "pocketpages",
    "pocketbase",
    "frame",
    "bookmarks",
    "daisyui",
    "tailwindcss"
  ],
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@vitejs/plugin-vue": "^5.2.4",
    "autoprefixer": "^10.6.2",
    "concurrently": "^9.2.1",
    "daisyui": "^4.12.23",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.10",
    "patch-package": "^8.0.1",
    "phio": "0.4.0",
    "prettier": "^3.6.2",
    "prettier-plugin-ejs": "^1.0.3",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "baseline-browser-mapping": "^2.9.17",
    "caniuse-lite": "^1.0.30001765",
    "pinia": "^3.0.4",
    "pocketbase": "^0.26.5",
    "pocketpages": "^0.22.3",
    "pocketpages-plugin-datastar": "^0.2.0",
    "pocketpages-plugin-js-sdk": "^0.2.0",
    "vue": "^3.5.45",
    "vue-router": "^4.6.5"
  },
  "files": [
    "pb_hooks",
    "*.md"
  ]
}
